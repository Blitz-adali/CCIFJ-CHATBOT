# Local development/preview proxy target (backend runs separately).
CCIFJ_API_TARGET=http://127.0.0.1:8000
# Empty = send /api requests through the proxy. For a deployed frontend, set
# this to your backend origin before building; backend CORS must allow your site.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=600000
CCIFJ_PROXY_TIMEOUT_MS=600000

# websocket (default), sse, or json. Fallback is allowed only before a chat turn is dispatched.
VITE_CHAT_TRANSPORT=websocket

# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CCIFJ_AUTH_SECRET=paste-the-generated-value-here
# "qwen" uses local Ollama models; any other value uses OpenAI (then OPENAI_API_KEY is required).
model_type="openai"
model_name="gpt-6-luna"
router_model_name="gpt-6-luna"
# Fill in your OpenAI key.
OPENAI_API_KEY=
# Optional reranking. Without a key, search uses hybrid fused ranking.
COHERE_API_KEY=

# --- Optional ---
trim_messages_max_token="1000"
CCIFJ_AGENT_TIMEOUT_SECONDS=180
# Staff inbox access: existing registered account IDs, never email addresses.
# Register an operator account, read its user_id from /api/v1/auth/me,
# then set this value and restart the API. Empty disables staff access.
CCIFJ_STAFF_USER_IDS=
# Comma-separated frontend origins, e.g. http://localhost:5173
CCIFJ_CORS_ORIGINS=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=realhackathon
LANGSMITH_AGENT_ENVIRONMENT=local

# OpenAI web search for market context and recent CCIFJ news (OpenAI models only). on/off, default on.
CCIFJ_WEB_SEARCH=on
# Comma-separated domains the web search may use; * = whole web.
CCIFJ_WEB_SEARCH_DOMAINS=*

# Optional Odoo CRM: when all four are set, approved staff requests are also created as leads.
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# --- WhatsApp / Slack (optional) ---
# Public address of the website; account-linking links sent to WhatsApp/Slack point here.
# Defaults to the first CCIFJ_CORS_ORIGINS entry.
CCIFJ_PUBLIC_URL=
# How long an account-linking link stays valid, in seconds (maximum 600).
CCIFJ_LINK_TOKEN_SECONDS=600
# WhatsApp Cloud API (Meta). Set all four to enable POST /api/v1/webhooks/whatsapp.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any private value; enter the same one as "Verify token" in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Slack app. Set both to enable POST /api/v1/webhooks/slack (Event Subscriptions: message.im).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

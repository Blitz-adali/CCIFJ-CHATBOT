# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CCIFJ_AUTH_SECRET=paste-the-generated-value-here
# "qwen" uses local Ollama models; any other value uses OpenAI (then OPENAI_API_KEY is required).
model_type="openai"
model_name="gpt-6-luna"
router_model_name="gpt-6-luna"
# Fill in your OpenAI key.
OPENAI_API_KEY=
# Needed by knowledge search reranking. Fill in your Cohere key.
# needed for knowledge-base reranking (search_vectordb)
COHERE_API_KEY=

# --- Optional ---
trim_messages_max_token="1000"
CCIFJ_AGENT_TIMEOUT_SECONDS=180
# Comma-separated frontend origins, e.g. http://localhost:5173
CCIFJ_CORS_ORIGINS=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=realhackathon
LANGSMITH_AGENT_ENVIRONMENT=local

# --- Optional: search and web ---
# Cohere rerank calls per minute. A trial key allows 10; raise this with a production key.
CCIFJ_RERANK_PER_MINUTE=9
# OpenAI web search for market context: on/off, allowed domains ("*" = whole web), and how much each search reads.
CCIFJ_WEB_SEARCH=on
CCIFJ_WEB_SEARCH_DOMAINS=*
CCIFJ_WEB_SEARCH_CONTEXT=low
# Force the embedding model's device (e.g. cpu). Empty = GPU when it works, CPU otherwise.
CCIFJ_EMBED_DEVICE=

# --- Optional: staff view (/staff.html). Off until set; 12 characters or more. ---
CCIFJ_STAFF_KEY=

# --- Optional: Odoo CRM (all four needed; approved staff requests become crm.lead records) ---
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
